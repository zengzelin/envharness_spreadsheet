+                'env_python_runtime_error': 'env/python_runtime_error',
+                'env_python_timeout': 'env/python_timeout',
+            }
+            for batch_key, info_key in spreadsheetbench_diagnostic_keys.items():
+                if info_key in infos[0]:
+                    batch.non_tensor_batch[batch_key] = np.array(
+                        [info.get(info_key, 0) for info in infos],
+                        dtype=np.float32,
+                    )
+
             if 'tool_calling' in infos[0]:
