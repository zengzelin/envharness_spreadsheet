             else:
                 batch.non_tensor_batch['is_action_valid'] = np.ones(batch_size, dtype=bool)
 
+            spreadsheetbench_diagnostic_keys = {
+                'parser_native_valid': 'parser/native_valid',
+                'parser_recovered': 'parser/recovered',
+                'parser_invalid': 'parser/invalid',
+                'output_char_len': 'output/char_len',
+                'output_has_think': 'output/has_think',
+                'output_has_markdown_fence': 'output/has_markdown_fence',
+                'output_tool_call_pos': 'output/tool_call_pos',
+                'env_python_error': 'env/python_error',
