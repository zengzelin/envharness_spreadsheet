+def _phase_message(event, name, started, details):
+    elapsed = time.monotonic() - started
+    detail_text = " ".join(f"{key}={value}" for key, value in details.items())
+    print(
+        f"[spreadsheet-rollout] {event} phase={name} "
+        f"elapsed_s={elapsed:.1f} {detail_text}".rstrip(),
+        flush=True,
+    )
+
+
+@contextmanager
+def _diagnostic_phase(name, *, enabled, heartbeat_s, **details):
+    if not enabled:
+        yield
+        return
+
+    started = time.monotonic()
+    stopped = threading.Event()
+    _phase_message("START", name, started, details)
+
+    def emit_heartbeats():
+        while not stopped.wait(heartbeat_s):
+            _phase_message("HEARTBEAT", name, started, details)
+
+    heartbeat = threading.Thread(
+        target=emit_heartbeats,
+        name=f"spreadsheet-rollout-{name}",
+        daemon=True,
+    )
+    heartbeat.start()
+    try:
+        yield
+    except BaseException as exc:
+        details = dict(details)
+        details["error"] = f"{type(exc).__name__}: {exc}"
+        _phase_message("ERROR", name, started, details)
+        raise
+    else:
+        _phase_message("END", name, started, details)
+    finally:
+        stopped.set()
+
